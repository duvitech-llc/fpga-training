[tasks]
tmds            prove a_tmds
tmds_cover      cover a_tmds
fifo            prove a_fifo
fifo_cover      cover a_fifo
intc            prove a_intc
intc_cover      cover a_intc
map             prove a_map
map_cover       cover a_map
arbiter3        prove a_arb
arbiter3_cover  cover a_arb

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 24
# Tutorial 10's FIFO proof: each clock is a free input, stepped by the solver.
fifo: multiclock on
fifo_cover: multiclock on
fifo: depth 40
fifo_cover: depth 40
arbiter3: depth 32
# The disparity reaches 8 only after a few characters.
tmds_cover: depth 12

[engines]
# As in Tutorial 31: the interconnect's own cover of every target answering in
# one cycle takes too long with this many slaves, so the map's cover run removes
# that one cover, below, and keeps the others.
~map_cover: smtbmc
map_cover: smtbmc bitwuzla

[script]
a_tmds: read -formal tmds_encoder.v
a_tmds: prep -top tmds_encoder
# The FIFO as the display uses it, 16 words. The width is cut to 8 bits: the
# ordering proof tracks any one word, and the data width does not change it.
a_fifo: read -formal gray_ptr.v async_fifo.v
a_fifo: chparam -set ADDR_WIDTH 4 async_fifo
a_fifo: prep -flatten -top async_fifo
a_intc: read -formal wb_checker.v wb_intc.v
a_intc: prep -top wb_intc
a_map: read -formal wb_checker.v wb_interconnect.v map_check.v
a_map: prep -top map_check
map_cover: chformal -cover -remove */a:src=*wb_interconnect.v:218.*
# Tutorial 29's arbiter proof, with three masters, as soc.v now uses it.
# Tutorial 8's arbiter is read without -formal, as in Tutorial 29.
a_arb: read -sv fixed_arbiter.v rr_arbiter.v
a_arb: read -formal wb_checker.v wb_arbiter.v
a_arb: chparam -set N 3 wb_arbiter
a_arb: prep -top wb_arbiter

[files]
rtl/tmds_encoder.v
rtl/gray_ptr.v
rtl/async_fifo.v
formal/wb_checker.v
formal/map_check.v
rtl/wb_intc.v
rtl/wb_interconnect.v
rtl/soc_map.vh
rtl/fixed_arbiter.v
rtl/rr_arbiter.v
rtl/wb_arbiter.v
