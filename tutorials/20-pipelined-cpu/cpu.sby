[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 14
cover: mode cover
cover: depth 16

[engines]
smtbmc

[script]
read -formal cpu.v
read -vlog2k decode.v alu_flags.v regfile.v enreg.v
hierarchy -top cpu
proc -norom
prep -top cpu

[files]
rtl/cpu.v
rtl/decode.v
rtl/alu_flags.v
rtl/regfile.v
rtl/enreg.v
