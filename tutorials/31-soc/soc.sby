[tasks]
map             prove a_map
map_cover       cover a_map
arbiter         prove a_arb
arbiter_cover   cover a_arb
gate            prove a_gate
gate_cover      cover a_gate
share           prove a_share
share_cover     cover a_share
intc            prove a_intc
intc_cover      cover a_intc
spi             prove a_spi
spi_cover       cover a_spi

[options]
prove: mode prove
prove: depth 8
arbiter: depth 32
share: depth 12
spi: depth 24
cover: mode cover
cover: depth 24
spi_cover: depth 48
map_cover: depth 24

[engines]
# With thirteen slaves, the interconnect's own cover of every target answering in
# one cycle takes too long: the first run had not reached it at step 25, after 10
# minutes. So the map's cover run removes that one cover, below, and keeps the
# others: each region and the hole after it are still reached, one at a time.
~map_cover: smtbmc
map_cover: smtbmc bitwuzla

[script]
a_map: read -formal wb_checker.v wb_interconnect.v map_check.v
a_map: prep -top map_check
map_cover: chformal -cover -remove */a:src=*wb_interconnect.v:218.*
# Tutorial 8's arbiter is read without -formal, as in Tutorial 29.
a_arb: read -sv fixed_arbiter.v rr_arbiter.v
a_arb: read -formal wb_checker.v wb_arbiter.v
a_arb: prep -top wb_arbiter
a_gate: read -formal wb_checker.v wb_gate.v gate_check.v
a_gate: prep -top gate_check
a_share: read -formal flash_share.v
a_share: prep -top flash_share
a_intc: read -formal wb_checker.v wb_intc.v
a_intc: prep -top wb_intc
# Tutorial 24's master without its own checks, as in Tutorial 28.
a_spi: read -formal wb_checker.v wb_spi.v
a_spi: read -sv spi_master.v shift_reg.v
a_spi: prep -top wb_spi

[files]
formal/wb_checker.v
formal/map_check.v
formal/gate_check.v
rtl/fixed_arbiter.v
rtl/rr_arbiter.v
rtl/wb_arbiter.v
rtl/wb_interconnect.v
rtl/soc_map.vh
rtl/wb_gate.v
rtl/flash_share.v
rtl/wb_intc.v
rtl/wb_spi.v
rtl/spi_master.v
rtl/shift_reg.v
