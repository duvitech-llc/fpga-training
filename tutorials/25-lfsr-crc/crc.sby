[tasks]
equiv
cover
lfsr

[options]
equiv: mode prove
equiv: depth 12
cover: mode cover
cover: depth 40
lfsr: mode prove

[engines]
smtbmc

[script]
equiv: read -formal crc32_serial.v crc32_byte.v crc32_byte_xor.v crc_equiv_formal.v
cover: read -formal crc32_serial.v crc32_byte.v crc32_byte_xor.v crc_equiv_formal.v
equiv: prep -top crc_equiv_formal
cover: prep -top crc_equiv_formal
lfsr: read -formal lfsr_fib.v lfsr_galois.v lfsr_formal.v
lfsr: prep -top lfsr_formal

[files]
rtl/crc32_serial.v
rtl/crc32_byte.v
rtl/crc32_byte_xor.v
rtl/lfsr_fib.v
rtl/lfsr_galois.v
tb/crc_equiv_formal.v
tb/lfsr_formal.v
