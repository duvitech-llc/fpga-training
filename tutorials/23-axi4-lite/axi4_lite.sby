[tasks]
waiting        prove wait rules
waiting_data   prove wait data
waiting_cover  cover wait data
buffered       prove buf rules
buffered_data  prove buf data
buffered_cover cover buf data

[options]
prove: mode prove
prove: depth 6
cover: mode cover
cover: depth 12

[engines]
smtbmc

[script]
read -formal axil_checker.v
rules: read -formal axil_regs.v
data: read -formal -D CHECK_DATA axil_regs.v
wait: chparam -set BUFFERED 0 axil_regs
buf: chparam -set BUFFERED 1 axil_regs
prep -top axil_regs

[files]
formal/axil_checker.v
rtl/axil_regs.v
